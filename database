-- 4. ĐẨY DỮ LIỆU VÀO BẢNG CHÍNH
-----------------------------------------------------------
INSERT INTO SanPham (ten_san_pham, duong_dan_seo, ma_sku, id_danh_muc, gia_ban, gia_nhap, so_luong_kho, nhan_san_pham, chat_lieu_chau, mo_ta, huong_dan_cham_soc, don_vi, trang_thai)
SELECT ten, slug, sku, dm_id, gia, gia*0.5, 100, nhan, chau, mota, cham, donvi, N'Đang bán' FROM @BulkPlants;

INSERT INTO AnhSanPham (id_san_pham, duong_dan_anh, la_anh_chinh)
SELECT s.id, b.img, 1
FROM SanPham s
JOIN @BulkPlants b ON s.ma_sku = b.sku;

GO

-- KIỂM TRA TỔNG SỐ LƯỢNG
SELECT COUNT(*) AS [Tổng số sản phẩm] FROM SanPham;
SELECT d.ten_danh_muc, COUNT(s.id) AS [Số lượng mỗi loại]
FROM DanhMuc d LEFT JOIN SanPham s ON d.id = s.id_danh_muc
GROUP BY d.ten_danh_muc;
