-- Tự động sinh thêm cho đủ 20 cây/loại với ảnh khác nhau
INSERT INTO @BulkPlants
SELECT 
    T.Ten + ' ' + P.Phu,
    LOWER(REPLACE(T.Ten, ' ', '-') + '-' + REPLACE(P.Phu, ' ', '-') + '-' + CAST(ROW_NUMBER() OVER(ORDER BY (SELECT NULL)) AS VARCHAR)),
    'AUTO-' + CAST(ROW_NUMBER() OVER(ORDER BY (SELECT NULL)) + 100 AS VARCHAR),
    C.ID,
    (ABS(CHECKSUM(NEWID())) % 20 + 5) * 10000,
    NULL, N'Chậu sứ trắng', N'Sản phẩm cao cấp được tuyển chọn cẩn thận.', N'Chăm sóc cơ bản theo hướng dẫn đi kèm.', 
    A.URL, N'Chậu'
FROM 
(VALUES (N'Cây'), (N'Lan'), (N'Trầu Bà'), (N'Tùng'), (N'Hoa'), (N'Xương Rồng'), (N'Hạt Giống'), (N'Sen Đá')) AS T(Ten)
CROSS JOIN 
(VALUES (N'Mini'), (N'Đột Biến'), (N'Công Trình'), (N'Thủy Sinh'), (N'Hàn Quốc'), (N'Văn Phòng'), (N'Cổ Thụ')) AS P(Phu)
CROSS JOIN (SELECT ID FROM DanhMuc) AS C
CROSS JOIN (VALUES 
    ('https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800'),
    ('https://images.unsplash.com/photo-1497250681960-ef046c08a56e?w=800'),
    ('https://images.unsplash.com/photo-1595013098651-787bc0ea9e80?w=800'), -- Fixed URL
    ('https://images.unsplash.com/photo-1520412099521-63bc1e9232ed?w=800'),
    ('https://images.unsplash.com/photo-1466781783364-0980628920e6?w=800')
) AS A(URL)
WHERE (ABS(CHECKSUM(NEWID())) % 100) < 40; -- Lấy ngẫu nhiên để không quá nhiều

